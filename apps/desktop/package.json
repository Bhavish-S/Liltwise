{
  "name": "@liltwise/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "dev": "electron-forge start",
    "build": "electron-forge package",
    "make:mac": "electron-forge make --platform darwin --arch arm64",
    "make:windows": "electron-forge make --platform win32 --arch x64",
    "lint": "eslint src forge.config.ts vite.*.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/companion-server.test.ts"
  },
  "dependencies": {
    "@liltwise/contracts": "workspace:*",
    "@liltwise/domain": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "electron": "44.7.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "7.3.7"
  }
}
